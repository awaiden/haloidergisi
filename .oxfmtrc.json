{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "experimentalSortPackageJson": {
    "sortScripts": true
  },
  "experimentalSortImports": {},
  "experimentalTailwindcss": {},
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "jsxSingleQuote": true,
  "singleAttributePerLine": true,
  "ignorePatterns": [
    "apps/web/src/routeTree.gen.ts",
    "apps/mobile/ios/**",
    "apps/mobile/macos/**",
    "apps/mobile/web/**",
    "apps/mobile/android/**"
  ]
}
